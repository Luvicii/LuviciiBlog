- const nav_music = theme.nav_music
-
  let navSongs = Array.isArray(nav_music.songs) && nav_music.songs.length ? nav_music.songs : null
  if (!navSongs && nav_music.list !== undefined && nav_music.list !== null) {
    const want = Array.isArray(nav_music.list) ? nav_music.list : [nav_music.list]
    const all = theme.music_playlist || []
    navSongs = []
    want.forEach(w => {
      const item = typeof w === 'number' ? all[w] : all.find(p => p && p.name === w)
      if (item && Array.isArray(item.songs)) navSongs = navSongs.concat(item.songs)
    })
  }
#nav-music
  a#nav-music-hoverTips(onclick='luvicii.musicToggle()' accesskey="m") 播放音乐
  #console-music-bg
  if navSongs && navSongs.length
    - const navDataApi = 'data:application/json,' + encodeURIComponent(JSON.stringify(navSongs))
    meting-js(api=navDataApi mutex="true" preload="none" theme="var(--luvicii-main)" data-lrctype="0" order="random" volume=nav_music.volume)
  else
    meting-js(id=nav_music.id server=nav_music.server type="playlist" mutex="true" preload="none" theme="var(--luvicii-main)" data-lrctype="0" order="random" volume=nav_music.volume)
