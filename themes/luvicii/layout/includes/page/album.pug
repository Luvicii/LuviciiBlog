#album
  - let album_background = page.top_background
  //- 横幅背景墙：优先用构建期自动生成的本地缩略图（见 scripts/photo-wall.js，360x600 webp，约 20~40KB）。
  //- 直接用相册原图时，壁纸那几张是 4K/5K（单张 7MB、解码后 59MB），缩到 181px 显示会明显掉帧。
  //- 缩略图缺失（例如机器上没装 ImageMagick）时回落到"按相册抽样原图"，功能不受影响。
  - const wallShuffle = arr => { const a = arr.slice(); for (let k = a.length - 1; k > 0; k--) { const j = Math.floor(Math.random() * (k + 1)); [a[k], a[j]] = [a[j], a[k]]; } return a; }
  - let wallCandidates = photo_wall_pool()
  if !wallCandidates.length
    - const wallPicked = []
    each a in site.data.album
      - const pool = []
      if a.cover
        - pool.push(a.cover)
      if a.album_list
        each it in a.album_list
          if it.image
            each im in it.image
              - pool.push(im)
      - wallPicked.push(...wallShuffle([...new Set(pool)]).slice(0, 4))
    - wallCandidates = [...new Set(wallPicked)]
  //- 每次刷新换一批：整池交给前端（data-pool），由 initPhotoWall 每次随机挑 12 张填进格子
  - const wallPhotos = wallCandidates.slice(0, 12)
  .author-content.author-content-item.album.single(style=`${album_background ? `background: url(${album_background}) top / cover no-repeat;` : ""}`)
    .photo-wall(data-pool=JSON.stringify(wallCandidates))
      .photo-wall-track
        each round in [0, 1, 2]
          each im in wallPhotos
            .photo-wall-tile
              //- 这里不写 src：每次刷新由 initPhotoWall 从 data-pool 里随机挑 12 张填进来，
              //- 保证只下载被选中的 12 张（每张约 20~40KB）。
              //- class 必须写 nolazyload：主题懒加载会把 img 改写成 1px 占位图 + data-lazy-src，
              //- 而墙是横向滑动的，"进入视口"要等动画滑到才会触发 → 加载时机散落在动画中途，每次都有一串长帧。
              img.photo-wall-img.nolazyload(alt='', decoding='async', fetchpriority='low', draggable='false')
    //- 无 JS 时也别让墙是空的
    noscript
      style.
        #album .photo-wall-tile img { opacity: 1 !important; transform: none !important; }
    .card-content
      .author-content-item-tips 相册集
      span.author-content-item-title 这里是我的相册集啦
      .content-bottom
        .tips 每一张照片都是一次美好的记忆。
      .banner-button-group
        a.banner-button(onclick='pjax.loadUrl("/about/")')
          i.luviciifont.luvicii-icon-arrow-circle-right(style='font-size: 1.5rem')
          span.banner-button-text 关于本人
  .card-album
    each i, index in site.data.album
      //- 堆叠照片：封面 + 相册内最多 6 张，--d 为相对中心的偏移序号（驱动 CSS 扇形展开）
      - const imgs = []
      if i.album_list
        each item in i.album_list
          if item.image
            each im in item.image
              - imgs.push(im)
      //- 候选池：构建时从相册里随机抽 36 张；前端每次刷新再从池里随机挑 7 张铺到堆叠上
      - const shuffle = arr => { const a = arr.slice(); for (let k = a.length - 1; k > 0; k--) { const j = Math.floor(Math.random() * (k + 1)); [a[k], a[j]] = [a[j], a[k]]; } return a; }
      - const candidates = shuffle([i.cover].concat(imgs.filter(im => im !== i.cover))).slice(0, 36)
      - const photos = candidates.slice(0, 7)
      - const center = (photos.length - 1) / 2
      .card(onclick=`pjax.loadUrl("${i.path_name}")`, style=`--i:${index}`)
        .stack(data-pool=JSON.stringify(candidates))
          each im, idx in photos
            - const d = idx - center
            //- 最顶上那张（DOM 最后一张）最先加载：eager + 高优先级，其余让路
            - const isTop = idx === photos.length - 1
            //- src 交给 luvicii.initAlbumStacks() 填，data-photo 是单图相册/JS 异常时的兜底
            img.stack-photo(data-photo=im, alt=i.class_name, loading=isTop ? "eager" : "lazy", fetchpriority=isTop ? "high" : "low", draggable="false", style=`--d:${d.toFixed(1)}; --d2:${(d * d).toFixed(2)}`)
        .card-info
          .card-name
            span.card-name-text=i.class_name
            if imgs.length
              span.card-count= imgs.length + ' 张'
          .card__heading=i.description
