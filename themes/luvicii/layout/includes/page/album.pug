#album
  - let album_background = page.top_background
  .author-content.author-content-item.album.single(style=`${album_background ? `background: url(${album_background}) top / cover no-repeat;` : ""}`)
    .card-content
      .author-content-item-tips 相册集
      span.author-content-item-title 这里是我的相册集哦😯
      .content-bottom
        .tips 每一张照片都是一次美好的记忆。
      .banner-button-group
        a.banner-button(onclick='pjax.loadUrl("/about/")')
          i.luviciifont.luvicii-icon-arrow-circle-right(style='font-size: 1.5rem')
          span.banner-button-text 关于本人
  .card-album
    each i in site.data.album
      //- 收集相册内图片：封面轮播 + 缩略图预览条 + 照片数量
      - const imgs = []
      if i.album_list
        each item in i.album_list
          if item.image
            each im in item.image
              - imgs.push(im)
      - const altCovers = imgs.filter(im => im !== i.cover).slice(0, 4)
      .card(onclick=`pjax.loadUrl("${i.path_name}")`)
        .card-covers
          img.card_cover.active(src=i.cover, alt=i.class_name)
          each im in altCovers
            img.card_cover(src=im, alt="", loading="lazy")
        .card-info
          .card__category
            span.card-name=i.class_name
            if imgs.length
              span.card-count= imgs.length + ' 张'
          .card__heading=i.description
          if imgs.length
            .card-thumbs
              each im in imgs.slice(0, 3)
                img(src=im, alt="", loading="lazy")
